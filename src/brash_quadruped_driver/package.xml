<?xml version="1.0"?>
<package format="3">
  <name>brash_quadruped_driver</name>
  <version>0.1.0</version>
  <description>Brash adapters and safety gates for the Unitree B2W platform.</description>
  <maintainer email="engineering@brashrobotics.com">Brash Robotics</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>unitree_go</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
